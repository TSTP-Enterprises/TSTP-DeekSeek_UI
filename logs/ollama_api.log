<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detroit Mechanic Shop</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #2c3e50;
            color: #ffffff;
        }

        .header {
            background-color: #1a2937;
            padding: 1rem;
            text-align: center;
            border-bottom: 1px solid #34495e;
        }

        .logo {
            font-size: 1.5rem;
            color: #dcdeed;
        }

        .menu-options {
            display: flex;
            gap: 2rem;
        }

        .menu-option {
            background-color: rgba(0,0,0,.7);
            padding: 1rem;
            border-radius: 4px;
            display: flex;
            align-items: center;
        }

        .menu-option:hover {
            color: #f0f0f0;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .mechanics {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .mechanic-card {
            background-color: rgba(42,59,87,.1);
            padding: 2rem;
            border-radius: 10px;
            border: 1px solid #34495e;
        }

        .mechanics-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .mechanic-name {
            font-size: 1.2rem;
            font-weight: bold;
            color: #e94560;
        }

        .mechanic-description {
            color: #818cf8;
            margin-bottom: 1rem;
        }

        .button {
            background-color: #dcdeed;
            border: 1px solid #34495e;
            padding: 1rem;
            color: #2c3e50;
            border-radius: 4px;
        }

        .button:hover {
            background-color: #bdc3c7;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="logo">DETROIT MECHANICS</div>
        <div class="menu-options">
            <div class="menu-option">Odometer Test</div>
            <div class="menu-option">Brake Check</div>
            <div class="menu-option">Fuel Systems</div>
            <div class="menu-option">Clutch Service</div>
            <div class="menu-option">Exhaust Work</div>
            <div class="menu-option">Tires & Alignment</div>
        </div>
    </header>

    <button onclick="toggleMenu()">Toggle Services</button>

    <div class="container">
        <div class="mechanics">
            <div class="mechanic-card">
                <h2 class="mechanic-header">
                    <div class="mechanic-name">John Smith</div>
                    <div class="mechanic-description">10 Years Experience</div>
                </h2>
                <p>$59/hour</p>
            </div>

            <div class="mechanic-card">
                <h2 class="mechanic-header">
                    <div class="mechanic-name">Sarah Johnson</div>
                    <div class="mechanic-description">15 Years Experience</div>
                </h2>
                <p>$79/hour</p>
            </div>

            <div class="mechanic-card">
                <h2 class="mechanic-header">
                    <div class="mechanic-name">Mike Chen</div>
                    <div class="mechanic-description">12 Years Experience</div>
                </h2>
                <p>$89/hour</p>
            </div>
        </div>
    </div>

    <div id="services" class="menu-option" onclick="toggleMenu()">Services</div>

    <script>
        function toggleMenu() {
            const menu = document.getElementById('services');
            if (menu.classList.contains('show')) {
                menu.remove();
            } else {
                menu.classList.add('show');
            }
        }

        // Add hover effect to mechanic cards
        document.querySelectorAll('.mechanic-card').forEach(card => {
            card.addEventListener('mouseover', () => {
                card.style.transform = 'translateY(-2px)';
            });
            
            card.addEventListener('mouseout', () => {
                card.style.transform = 'translateY(0)';
            });
        });
    </script>
</body>
</html>
```

