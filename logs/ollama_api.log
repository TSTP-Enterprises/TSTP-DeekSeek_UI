<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classic Auto Shop - Mechanic Services</title>
    <style>
        :root {
            --bg-color: #2c3e50;
            --text-color: #dc recreate your text color here.

        }
        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            font-family: Arial, sans-serif;
        }

        header {
            background-color: rgba(44, 62, 80, 0.95);
            padding: 1rem;
            color: white;
            text-align: center;
        }

        .shop-name {
            font-size: 3rem;
            margin-bottom: 1rem;
            letter-spacing: 3px;
        }

        .services {
            padding: 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .service-card {
            background-color: white;
            border-radius: 10px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

        .service-card:hover {
            transform: translateY(-5px);
        }

        .service-card h3 {
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }

        about {
            padding: 4rem 2rem;
            text-align: center;
            color: rgba(255, 255, 255, 0.7);
        }
    </style>
</head>
<body>
    <header>
        <h1 class="shop-name">Classic Auto Shop</h1>
    </header>

    <div class="services">
        <div class="service-card">
            <h3>Car Inspections</h3>
            <p>Detailed inspection reports and free estimates</p>
        </div>

        <div class="service-card">
            <h3>Mechanic Services</h3>
            <p>Odometer readings, alignments, and repairs</p>
        </div>

        <div class="service-card">
            <h3>Replacement</h3>
            <p>Batteries, brakes, and other parts</p>
        </div>
    </div>

    <div class="services">
        <div class="service-card" style="transform: translateY(20px);">
            <h3>Brake Repairs</h3>
            <p>Expert brake system inspections and replacements</p>
        </div>

        <div class="service-card" style="transform: translateY(20px);">
            <h3>Tire Rotations</h3>
            <p>Regular and balanced tire rotations</p>
        </div>
    </div>

    <div class="services">
        <div class="service-card">
            <h3>Transmission Work</h3>
            <p>Expert transmission repairs and fluid changes</p>
        </div>

        <div class="service-card">
            <h3>Clutch Replacements</h3>
            <p>Professional clutch system installations</p>
        </div>
    </div>

    <script>
        // Add smooth scrolling to the service cards
        document.querySelectorAll('.service-card').forEach(card => {
            card.addEventListener('mouseover', () => {
                setTimeout(() => {
                    card.style.transform = 'translateY(-10px)';
                }, 50);
            });
            
            card.addEventListener('mouseout', () => {
                setTimeout(() => {
                    card.style.transform = 'translateY(0)';
                }, 50);
            });
        });

        // Add header animation
        window.addEventListener('scroll', function() {
            const header = document.querySelector('header');
            if (window.scrollY > 100) {
                header.style.transform = 'translateY(-50px)';
            } else {
                header.style.transform = 'translateY(0)';
            }
        });
    </script>
</body>
</html>
```

