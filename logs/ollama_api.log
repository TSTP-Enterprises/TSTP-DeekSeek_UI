Here's a simple PyQt5 program that creates a window with a "Start" button that displays a help message when clicked:

```python
import sys
from PyQt5.QtCore importQMainWindow
from PyQt5.QtWidgets import (QPushButton, QMessageBox)

class TSTPHelper(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("TSTP DeepSeek Helper")
        self.setGeometry(200, 150, 250, 150)
        self.moveCenter()
        
    def moveCenter(self):
        qr = self.frameGeometry()
        cp = qr.toConsolePosition()
        self.move(cp.x(), cp.y())
        
    def createInterface(self):
        layout = QLayout()
        title = QLabel("TSTP DeepSeek Helper")
        layout.addWidget(title, 1)

        buttonBox = QHBoxLayout()
        button = QPushButton("Start")
        buttonBox.addWidget(button)
        button.setGeometry(50, 20, 100, 40)
        button.setStyleSheet("""
            QPushButton {
                background-color: #ffffff;
                border-radius: 4px;
                width: 120px;
                height: 30px;
                margin-left: 8px;
            }
            QPushButton:hover {
                background-color: #f0f0f0;
            }
        """)
        buttonBox.addStretch()
        self.setLayout(layout.addWidget(buttonBox))

    def onButtonClick(self):
        QMessageBox.information(
            None,
            "TSTP DeepSeek Helper",
            "TSTP DeepSeek Helper",
            QMessageBox.Info,
            QMessageBox defaultButton= QMessageBox_ok
        )

if __name__ == "__main__":
    app = QApplication(sys.argv)
    helper = TSTPHelper()
    helper.show()
    sys.exit(app.exec_())
```

This program will:
1. Create a centered window with the title "TSTP DeepSeek Helper"
2. Have a "Start" button in the center of the screen
3. When the button is clicked, it shows an information dialog with the message "TSTP DeepSeek Helper"

The button has a white background and blue border-radius for better visual appeal.

