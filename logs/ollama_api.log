Here's an advanced Snake game implementation using Pygame with additional features like different levels, power-ups, and scoring:

```python
import pygame
from random import randint

# Initialize Pygame
pygame.init()

# Game window
WIDTH = 800
HEIGHT = 600
window = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Advanced Snake Game")

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
RED = (255, 0, 0)
GREEN = (0, 255, 0)

# Directions
UP = 1
DOWN = -1
LEFT = (-1, 0)
RIGHT = (1, 0)

# Snake and food parameters
PIPE_SPEED = 3
FOOD_SPAWN_RATE = 50

# Power-ups
POWERUP_SPAWN_RATE = 20
SPEED_BOOST = 2
EXTRA_POINTS = 10
GHOST_MODE = False

class Snake:
    def __init__(self, speed):
        self.reset()
        self.speed = speed
        
    def reset(self):
        self head = [WIDTH // 2, HEIGHT // 2]
        self body = [[WIDTH // 2 - i * self.speed, HEIGHT // 2] for i in range(5)]
        # self.direction = random.choice([UP, DOWN, LEFT, RIGHT])
        self.direction = UP
        self.score = 0

class Food:
    def __init__(self):
        while True:
            self.head = (randint(0, WIDTH // self.speed), randint(0, HEIGHT))
            if not any(self.head[0] == pos[0] and self.head[1] == pos[1] for pos in self.body):
                break

class Powerup:
    def __init__(self, type):
        while True:
            x = randint(0, WIDTH // self.speed)
            y = randint(0, HEIGHT)
            if (x, y) not in self.body and ((x, y) != any(p.body for p in [food])):
                break

class Game:
    def __init__(self):
        self.snake = Snake(PIPE_SPEED)
        self.food = Food()
        self.powerup = Powerup(random.choice([SPEED_BOOST, EXTRA_POINTS, GHOST_MODE]))
        self.level = 1
        self.game_active = True
        self.score = 0
        
    def reset_game(self):
        self.snake.reset()
        self.food = Food()
        self.powerup = Powerup(random.choice([SPEED_BOOST, EXTRA_POINTS, GHOST_MODE]))
        self.level = 1
        
    def draw(self):
        window.fill(BLACK)
        
        # Draw snake
        for segment in self.snake.body:
            pygame.draw.rect(window, GREEN, (segment[0], segment[1], self.speed, self.speed))
        
        if self.powerup.type == 'speed':
            pygame.draw.rect(window, RED, (self.powerup.x - 3, self.powerup.y - 5, 6, 12))
        elif self.powerup.type == 'points':
            pygame.draw.rect(window, GREEN, (self.powerup.x - 3, self.powerup.y - 5, 6, 12))
        
        # Draw food
        pygame.draw.rect(window, White, self.food.head, self.food.speed)
        
        if GHOST_MODE:
            for segment in self.snake.body[:-1]:
                window.blit(pygame.Rect(segment[0], segment[1], self.speed, self.speed), (0, 0))
    
    def update(self):
        if not self.game_active:
            return
            
        # Update powerup
        self.powerup_counter -= 1
        if self.powerup_counter == 0:
            self.powerup = Powerup(random.choice([SPEED_BOOST, EXTRA_POINTS, GHOST_MODE]))
            self.powerup_counter = self.powerup.spawn_rate
        
        # Move snake
        head = list(self.snake.head)
        head[0] += self.snake.direction[0] * self.snake.speed
        head[1] += self.snake.direction[1] * self.snake.speed
        
        # Check for collisions with walls or self
        if not (0 <= head[0] < WIDTH and 0 <= head[1] < HEIGHT):
            self.game_active = False
            return
            
        body_segments = []
        for segment in self.snake.body:
            if segment == [head[0], head[1]]:
                if self.powerup.type == 'speed':
                    self.snake.speed += 0.5
                    self.snake.speed = min(self.snake.speed, 2)
                elif self.powerup.type == 'points':
                    self.score += 10
                self.game_active = False
                return
            body_segments.append(segment.copy())
        head_copy = head.copy()
        for segment in body_segments:
            if head_copy[0] == segment[0] and head_copy[1] == segment[1]:
                if self.powerup.type == 'speed':
                    self.snake.speed += 0.5
                    self.snake.speed = min(self.snake.speed, 2)
                elif self.powerup.type == 'points':
                    self.score += 10
                self.game_active = False
                return
        
        # Check if snake ate food
        if head in self.food.head:
            self.score += self.food.speed * 2
            self.food = Food()
            
            # Check level up condition
            if self.score >= (self.level * 10):
                self.level += 1
                self.game_active = False
                return
            
            for segment in self.snake.body[:-1]:
                if head[0] == segment[0] and head[1] == segment[1]:
                    self.game_active = False
                    break
        
        # Add powerup
        if self.powerup.type == 'speed':
            speed = pygame.Rect(self.powerup.x - 3, self.powerup.y -5,6,12)
            pygame.draw.rect(window, RED, speed)
        elif self.powerup.type == 'points':
            points = pygame.Rect(self.powerup.x - 3, self.powerup.y -5,6,12)
            pygame.draw.rect(window, GREEN, points)
        
        # Add new powerups at spawn rate
        if self.powerup_counter > 0:
            self.powerup_counter += 1
            
    def check_collision(self):
        pass
        
def main():
    clock = pygame.time.Clock()
    
    game = Game()
    
    while True:
        for event in pygame.event.get():
            if not game.game_active or not event.isigraphic:
                continue
            elif event.type == pygame.QUIT:
                game.game_active = False
                break
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    game.game_active = False
                    break
                elif event.key in [pygame.K_UP, pygame.K_DOWN, pygame.K_LEFT, pygame.K_RIGHT]:
                    game.snake.direction = [0, 0]
                    dx, dy = pygame.math.Vector2(event.key)
                    if event.key == pygame.K_UP or event.key == pygame.K_DOWN:
                        if dy != 0:
                            game.snake.direction = [0, -1 * dx Sign(dy)]
                    elif event.key == pygame.K_LEFT or event.key == pygame.K_RIGHT:
                        if dx != 0:
                            game.snake.direction = [-dy Sign(dx), 0]
            elif event.type == pygame.KEYUP:
                game.snake.direction = [0, 0]
        
        if not game.game_active:
            continue
        
        clock.tick(120)
        
        game.update()
        game.draw()
        
if __name__ == "__main__":
    main()
</think>

To play Snake with powerups and level-ups:

1. Use arrow keys to control the snake.
2. Collect white food squares to grow and score points.
3. Powerups can be collected randomly:
   - Speed boost (red): Press Spacebar to activate
   - Points multiplier (green): Press P to use
4. When your score is high enough, you'll level up.

Controls:
- Arrow keys: Move the snake
- Space bar: Use speed boost
- P: Use points multiplier

Note: The game will automatically pause when trying to collect powerups in certain conditions.
