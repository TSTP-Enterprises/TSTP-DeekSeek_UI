<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DT Mechanix - Fake Mechanic Shop</title>
    <style>
        body {
            font-family: 'Courier New', monospace;
            background-color: #2c3e50;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 800px;
            padding: 40px;
            background-color: #34495e;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            color: #ecf0f1;
            font-size: 2.5rem;
        }

        .header p {
            color: #bdc3c7;
            font-size: 1.2rem;
        }

        .menu {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .menu a {
            color: #bdc3c7;
            text-decoration: none;
            font-size: 1.1rem;
            transition: color 0.3s ease;
        }

        .menu a:hover {
            color: #ecf0f1;
        }

        .menu a.active {
            color: #ecf0f1;
        }

        .detail {
            background-color: #28a745;
            border-top: 1px solid #1e903c;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        @media (max-width: 600px) {
            .container {
                padding: 20px;
            }
            
            .menu {
                gap: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>DT Mechanix</h1>
            <p>Fantastic Detroit Mechanic Services Since 1969</p>
        </header>

        <section class="menu" id="menu">
            <a href="#oil-change">Oil Change</a>
            <a href="#tires">Tires</a>
            <a href="#brakes">Brakes</a>
            <a href="#mechanical">Mechanical Services</a>
        </section>

        <section class="detail" id="example">
            <h2>Example Service: Oil Change</h2>
            <p>A professional oil change for your car or truck in Detroit.</p>
            <button onclick="scrollToDetail('example')">View Details</button>
        </section>

        <footer class="menu" id="contact">
            <p>Contact us: (555) 123-4567 | info@dtmechanix.com</p>
            <p>Address: 123 Auto Rd, Detroit, MI 48201</p>
        </footer>
    </div>

    <script>
        // Add smooth scrolling to menu items
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // Add hover effect to detail section
        const(detailContainer) = document.getElementById('example');
        detailContainer.addEventListener('mouseover', function() {
            this.style.backgroundColor = '#28a745';
        });

        detailContainer.addEventListener('mouseout', function() {
            this.style.backgroundColor = '#2c3e50';
        });
    </script>
</body>
</html>
```

