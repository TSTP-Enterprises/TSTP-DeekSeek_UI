class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Hello World App")
        self.setGeometry(100, 100, 200, 150)

        # Create a central widget
        self.setCentralWidget(QWidget())
        
        # Create and add the "Start" button
        self.button = QPushButton("Start")
        self.button.resize(100, 30)
        selfcentral_widget.addWidget(self.button)
        self.button.clicked.connect(self.actionFunction)

    def actionFunction(self):
        sys.exit(0)  # Exit the application after first click

if __name__ == "__main__":
    app = MainWindow()
    app.show()
    app.button.clicked.connect(app.actionFunction)
    import sys
    sys.exit(app.exec_())
```

