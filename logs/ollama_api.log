<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DT Mechanix</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #2c3e50;
            margin: 0;
            padding: 20px;
        }

        .shop-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .header-title {
            font-size: 3em;
            color: #ecf0f1;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .main-content {
            max-width: 800px;
            margin: 0 auto;
        }

        .service-card {
            background-color: #3498db;
            border: 1px solid #2c3e50;
            padding: 20px;
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }

        .service-card:hover {
            transform: translateY(-5px);
        }

        .footer {
            text-align: center;
            margin-top: 40px;
            padding-top: 20px;
            color: #7f8c8d;
        }
    </style>
</head>
<body>
    <header class="shop-header">
        <h1 class="header-title">DT Mechanix</h1>
    </header>

    <div class="main-content">
        <div class="service-card" id="brake repair">
            Brake Repair & Maintenance<br>
            Expert car care for your brakes
        </div>

        <div class="service-card" id="wheel alignment">
            Wheel Alignment & Balanced Rotations<br>
            Perfecting your vehicle's rotation
        </div>

        <div class="service-card" id="tires">
            Tires & Maintenance<br>
            High-quality tire replacements
        </div>

        <div class="service-card" id="exhaust">
            Exhaust System Installation<br>
            Custom exhaust solutions
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2024 DT Mechanix. All rights reserved.</p>
    </footer>

    <script>
        // Add hover effect to service cards
        document.querySelectorAll('.service-card').forEach(card => {
            card.addEventListener('mouseover', () => {
                card.style.display = 'block';
            });
            
            card.addEventListener('mouseout', () => {
                card.style.display = 'none';
            });
        });

        // Optional: Add click event for additional action
        document.querySelectorAll('.service-card').forEach(card => {
            card.addEventListener('click', () => {
                card.style.display = 'block';
            });
        });
    </script>
</body>
</html>
```

