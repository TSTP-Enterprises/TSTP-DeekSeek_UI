from PyQt5.QtWidgets import QMainWindow, QMessageBox
from PyQt5.QtCore import Qt

class StartWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("TSTP DeepSeek Helper")
        self.setGeometry(0, 0, 300, 150)
        self.setWindowFlag(Qt.WindowStaysOnTopAllDays)

    def show_help(self):
        QMessageBox.information(
            self,
            "TSTP DeepSeek Helper",
            "Welcome to TSTP DeepSeek Helper.",
            QMessageBox.Ok
        )

def main():
    app = QApplication([])
    window = StartWindow()
    window.show()
    app.exec()

if __name__ == "__main__":
    main()
```

